<!--
  Add inside <ossec_config> in single-node/config/wazuh_cluster/wazuh_manager.conf (docs/05-cloudtrail.md).
  The manager pulls CloudTrail logs from S3 every 10 minutes as a read-only IAM user (aws/wazuh-cloudtrail-reader.yaml).
  The credentials file is mounted read-only at /root/.aws/credentials with a profile named [wazuh].
-->
<wodle name="aws-s3">
  <disabled>no</disabled>
  <interval>10m</interval>
  <run_on_start>yes</run_on_start>
  <skip_on_error>yes</skip_on_error>
  <bucket type="cloudtrail">
    <name><CLOUDTRAIL_BUCKET></name>
    <aws_profile>wazuh</aws_profile>
    <!-- Backfill from the trail's first day. The default is "today only". Format: YYYY-MMM-DD -->
    <only_logs_after><FIRST_LOG_DATE e.g. 2026-OCT-06></only_logs_after>
  </bucket>
</wodle>
